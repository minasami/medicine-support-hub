PORT=8787
MCP_PATH=/mcp
MCP_PUBLIC_URL=https://mcp.medicinesupport.app
MCP_RESOURCE_URI=https://mcp.medicinesupport.app/mcp
MCP_OAUTH_ISSUER=https://mcp.medicinesupport.app
# HMAC secret for access/refresh/auth-code/DCR JWTs (min 16 chars). Never commit real values.
MCP_OAUTH_SIGNING_SECRET=
# Optional aliases
# MCP_JWT_SECRET=
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a54ac3a00272c02d6e0
APPWRITE_DATABASE_ID=medicine_support_hub
APPWRITE_MEDICINES_COLLECTION_ID=medicines
# Server API key with Databases read/write for mcp_support_requests, prescriptions,
# drug_contributions, user_watchlist (and medicines read for price alerts).
APPWRITE_API_KEY=
APPWRITE_MCP_SUPPORT_COLLECTION_ID=mcp_support_requests
APPWRITE_USER_WATCHLIST_COLLECTION_ID=user_watchlist
APPWRITE_PRESCRIPTIONS_COLLECTION_ID=prescriptions
APPWRITE_PRESCRIPTION_ITEMS_COLLECTION_ID=prescription_items
APPWRITE_DRUG_CONTRIBUTIONS_COLLECTION_ID=drug_contributions
PUBLIC_SITE_URL=https://medicinesupport.app
CORS_ORIGIN=*
RATE_LIMIT_PER_MIN=60
# Optional partner TPA (leave empty = local hints only). Never put member IDs here.
TPA_BASE_URL=
TPA_API_KEY=
TPA_TIMEOUT_MS=8000
# OpenAI Apps domain verification (plain text at /.well-known/openai-apps-challenge)
OPENAI_APPS_CHALLENGE=

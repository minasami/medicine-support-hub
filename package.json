{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --filter @workspace/web dev",
    "typecheck": "pnpm exec tsc -b lib/api-client-react/tsconfig.json && pnpm --filter @workspace/web typecheck",
    "generate:seo": "node scripts/generate-seo-artifacts.mjs",
    "build": "pnpm run generate:seo && pnpm --filter @workspace/web build",
    "build:appwrite": "node scripts/prepare-static-dataset.mjs && node scripts/prepare-appwrite-native-deps.mjs && pnpm run validate && node scripts/prepare-appwrite-static.mjs",
    "validate": "pnpm run typecheck && pnpm run build",
    "validate:ts": "node node_modules/typescript/lib/tsc.js -p lib/api-client-react/tsconfig.json --noEmit && node node_modules/typescript/lib/tsc.js -p apps/web/tsconfig.json --noEmit && echo TypeScript OK",
    "validate:donation-csv": "node scripts/validate-donation-csv.mjs",
    "test:donation-csv": "node scripts/test-donation-csv.mjs",
    "test:donation-schema": "node scripts/test-donation-schema.mjs",
    "test:mapping-accuracy": "node scripts/test-mapping-accuracy.mjs",
    "validate:map": "node scripts/check-map-data.mjs",
    "import:medicines": "node scripts/import-egyptian-medicines.mjs",
    "export:medicines": "node scripts/export-appwrite-medicines.mjs",
    "map:ids": "node scripts/map-static-to-live-ids.mjs --write",
    "map:ids:dry": "node scripts/map-static-to-live-ids.mjs --dry-run",
    "map:ids:strict": "node scripts/map-static-to-live-ids.mjs --write --strict",
    "map:pipeline": "pnpm run export:medicines && pnpm run map:ids",
    "drugeye:search": "node scripts/drugeye-client.mjs",
    "drugeye:enrich": "node scripts/enrich-appwrite-from-drugeye.mjs",
    "drugeye:enrich:dry": "node scripts/enrich-appwrite-from-drugeye.mjs --dry-run",
    "egyptdwa:parse": "node scripts/parse-egyptdwa-medicines.mjs",
    "egyptdwa:enrich": "node scripts/enrich-appwrite-from-egyptdwa.mjs",
    "egyptdwa:enrich:dry": "node scripts/enrich-appwrite-from-egyptdwa.mjs --dry-run",
    "tariff:parse": "node scripts/parse-moh-eda-tariff.mjs",
    "tariff:enrich": "node scripts/enrich-appwrite-from-moh-tariff.mjs",
    "tariff:enrich:dry": "node scripts/enrich-appwrite-from-moh-tariff.mjs --dry-run",
    "sync:appwrite-db": "node scripts/sync-supabase-to-appwrite-db.mjs",
    "create:appwrite-indexes": "node --env-file=.env scripts/create-appwrite-indexes.mjs",
    "mobile:sync": "pnpm run build && cap sync",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:build:android": "node scripts/build-android-bundle.mjs"
  },
  "private": true,
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "appwrite": "^15.0.0",
    "node-appwrite": "^14.1.0",
    "stripe": "^22.3.1",
    "xlsx": "npm:@e965/xlsx@^0.20.3"
  },
  "packageManager": "pnpm@11.20.0"
}
